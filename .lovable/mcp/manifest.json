{
  "version": 1,
  "sdk_version": "3.0.5",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://zpdornzxupokchgkaoqs.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "khidr",
      "version": "0.2.0",
      "title": "Khidr"
    },
    "tools": [
      {
        "name": "list_content",
        "title": "List site content",
        "description": "List content items (admin only), filtered by type and status (published, draft or trash), optionally with all fields.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "type": {
              "description": "Content type filter.",
              "type": "string",
              "enum": [
                "book",
                "project",
                "article",
                "research",
                "gallery"
              ]
            },
            "status": {
              "description": "Status filter (default: all non-deleted).",
              "type": "string",
              "enum": [
                "published",
                "draft",
                "trash",
                "all"
              ]
            },
            "full": {
              "description": "Return every field (body, tags, links, meta).",
              "type": "boolean"
            },
            "limit": {
              "description": "Max items (default 30).",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "get_content",
        "title": "Get content item",
        "description": "Return every field of one content item, including body, tags, links and meta (admin only).",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "Content item id."
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "create_content",
        "title": "Create site content",
        "description": "Add a book, project, article, research paper or gallery photo to the site (admin only). Saved as draft unless status is 'published'.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "book",
                "project",
                "article",
                "research",
                "gallery"
              ],
              "description": "Content type."
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300,
              "description": "Title."
            },
            "excerpt": {
              "description": "Short summary.",
              "type": "string",
              "maxLength": 1000
            },
            "body": {
              "description": "Full text (Markdown).",
              "type": "string",
              "maxLength": 100000
            },
            "category": {
              "description": "Category.",
              "type": "string",
              "maxLength": 100
            },
            "tags": {
              "description": "Tags.",
              "maxItems": 30,
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 50
              }
            },
            "cover_url": {
              "description": "Cover or photo image URL.",
              "type": "string",
              "format": "uri"
            },
            "links": {
              "description": "Links such as GitHub or demo.",
              "maxItems": 10,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string",
                    "maxLength": 60
                  },
                  "url": {
                    "type": "string",
                    "format": "uri"
                  }
                },
                "required": [
                  "label",
                  "url"
                ]
              }
            },
            "meta": {
              "description": "Extra details, e.g. year, pages, publisher, readTime, license, camera, location.",
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "string",
                "maxLength": 200
              }
            },
            "status": {
              "description": "Publish now or keep as draft (default draft).",
              "type": "string",
              "enum": [
                "published",
                "draft"
              ]
            }
          },
          "required": [
            "type",
            "title"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "update_content",
        "title": "Update content item",
        "description": "Edit fields of an existing content item in place (admin only). Only the fields you pass are changed.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "Content item id."
            },
            "type": {
              "type": "string",
              "enum": [
                "book",
                "project",
                "article",
                "research",
                "gallery"
              ]
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "slug": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "excerpt": {
              "type": "string",
              "maxLength": 1000
            },
            "body": {
              "type": "string",
              "maxLength": 100000
            },
            "category": {
              "type": "string",
              "maxLength": 100
            },
            "tags": {
              "maxItems": 30,
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 50
              }
            },
            "cover_url": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uri"
                },
                {
                  "type": "null"
                }
              ]
            },
            "images": {
              "maxItems": 50,
              "type": "array",
              "items": {
                "type": "string",
                "format": "uri"
              }
            },
            "links": {
              "maxItems": 10,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string",
                    "maxLength": 60
                  },
                  "url": {
                    "type": "string",
                    "format": "uri"
                  }
                },
                "required": [
                  "label",
                  "url"
                ]
              }
            },
            "meta": {
              "description": "Replaces meta entirely.",
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "string",
                "maxLength": 200
              }
            },
            "status": {
              "type": "string",
              "enum": [
                "published",
                "draft"
              ]
            },
            "featured": {
              "type": "boolean"
            },
            "sort_order": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "set_content_status",
        "title": "Publish or unpublish content",
        "description": "Change a content item's status to published or draft (admin only).",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "Content item id from list_content."
            },
            "status": {
              "type": "string",
              "enum": [
                "published",
                "draft"
              ],
              "description": "New status."
            }
          },
          "required": [
            "id",
            "status"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "delete_content",
        "title": "Move content to trash",
        "description": "Soft-delete a content item: it moves to the trash and disappears from the site, but can be restored with restore_content (admin only).",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "Content item id."
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "restore_content",
        "title": "Restore content from trash",
        "description": "Restore a soft-deleted content item from the trash (admin only).",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "Content item id."
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "check_site_health",
        "title": "Check site health",
        "description": "Read-only audit: published items missing title/excerpt/image, broken links, duplicates, pages without basic SEO, and RLS/open policy issues (admin only).",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": true
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "list_messages",
        "title": "Read contact messages",
        "description": "Read the latest messages visitors sent through the contact form (admin only).",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "limit": {
              "description": "How many messages (default 10).",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      }
    ]
  }
}
